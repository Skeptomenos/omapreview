# Maintainer: David Hapunkt <Skeptomenos@users.noreply.github.com>
pkgname=omapreview
pkgver=0.1.1
pkgrel=1
pkgdesc="Preview-style PDF viewer and reviewer for Linux"
arch=('any')
url="https://github.com/Skeptomenos/omapreview"
license=('AGPL-3.0-or-later')
depends=('python' 'python-pymupdf' 'gtk4' 'python-gobject' 'python-cairo')
optdepends=(
  'python-mcp: MCP server for AI agents (omapreview-mcp)'
  'omarchy: bar widget and menu-based PDF picker'
)
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-wheel')
# Deterministic application source asset; extracts to omapreview-$pkgver.
source=("$pkgname-$pkgver-src.tar.gz::https://github.com/Skeptomenos/omapreview/releases/download/v$pkgver/omapreview-$pkgver-src.tar.gz")
sha256sums=('523f5ff7f11a488cc09b6f454f8fdfaf85268e2ed21faca314a84dfbc41a5b6d')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm755 bin/omepreview-pick "$pkgdir/usr/bin/omepreview-pick"
  install -Dm644 share/omapreview.desktop "$pkgdir/usr/share/applications/omapreview.desktop"
  install -Dm644 share/icons/omapreview.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/omapreview.png"

  install -d "$pkgdir/usr/share/omapreview"
  cp -r shell-plugin "$pkgdir/usr/share/omapreview/shell-plugin"
  cp -r skill "$pkgdir/usr/share/omapreview/skill"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
