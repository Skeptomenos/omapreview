# omapreview
#
# %f is omitted when the launcher starts with no file, so Exec becomes
# `omapreview edit` and the editor opens empty. MIME open still passes a path.
# Do not put a file picker in Exec. Open is in-app.

[Desktop Entry]
Type=Application
Name=omapreview
GenericName=PDF Viewer
Comment=Read, annotate, and sign PDFs
Exec=omapreview edit %f
TryExec=omapreview
Icon=omapreview
MimeType=application/pdf;
Categories=Office;Viewer;
Keywords=PDF;annotate;sign;redact;omapreview;
Terminal=false
StartupNotify=true
StartupWMClass=org.omepreview.Editor
